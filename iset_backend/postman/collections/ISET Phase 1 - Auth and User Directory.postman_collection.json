{
  "info": {
    "_postman_id": "e6a1c9f2-4d31-4b0e-9a55-7c1d2e3f4a01",
    "name": "ISET Phase 1 - Auth and User Directory",
    "description": "Run the requests in order after starting the backend. Each request has assertions; keep the 'ISET Backend - Local' environment selected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('backend reports running', () => pm.expect(pm.response.json().status).to.eql('ISET Backend is running'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('sidA', 'PM_A_' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('user id returned', () => pm.expect(pm.response.json().user_id).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"{{sidA}}\",\n  \"name\": \"Postman Alice\",\n  \"password\": \"secretA1\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "response": []
    },
    {
      "name": "03 Duplicate registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('duplicate error message', () => pm.expect(pm.response.json().error).to.eql('Student ID already exists'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"{{sidA}}\",\n  \"name\": \"Postman Alice\",\n  \"password\": \"secretA1\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "response": []
    },
    {
      "name": "04 Invalid registration input",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"BAD_EMPTY\",\n  \"name\": \"\",\n  \"password\": \"123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "response": []
    },
    {
      "name": "05 Register B",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('sidB', 'PM_B_' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"{{sidB}}\",\n  \"name\": \"Postman Bob\",\n  \"password\": \"secretB1\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "response": []
    },
    {
      "name": "06 Login A wrong password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"{{sidA}}\",\n  \"password\": \"wrong-password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "response": []
    },
    {
      "name": "07 Login A valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('token returned', () => pm.expect(j.token).to.be.a('string'));",
              "pm.test('user returned', () => pm.expect(j.user.student_id).to.eql(pm.environment.get('sidA')));",
              "pm.environment.set('tokenA', j.token);",
              "pm.environment.set('idA', String(j.user.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"{{sidA}}\",\n  \"password\": \"secretA1\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "response": []
    },
    {
      "name": "08 Login B valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.environment.set('tokenB', j.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"{{sidB}}\",\n  \"password\": \"secretB1\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "response": []
    },
    {
      "name": "09 Me (restore session)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('correct user', () => pm.expect(String(pm.response.json().user.id)).to.eql(pm.environment.get('idA')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "response": []
    },
    {
      "name": "10 User directory (A)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const users = pm.response.json().users;",
              "pm.test('other student listed', () => pm.expect(users.some(u => u.student_id === pm.environment.get('sidB'))).to.be.true);",
              "pm.test('self excluded', () => pm.expect(users.some(u => u.student_id === pm.environment.get('sidA'))).to.be.false);",
              "pm.test('no password leaked', () => users.forEach(u => pm.expect(u).to.not.have.property('password')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
        "url": "{{baseUrl}}/api/auth/users"
      },
      "response": []
    },
    {
      "name": "11 Directory without token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/users"
      },
      "response": []
    },
    {
      "name": "12 Directory with invalid token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer garbage-token" }],
        "url": "{{baseUrl}}/api/auth/users"
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ]
}
